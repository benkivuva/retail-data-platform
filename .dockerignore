# Version control
.git/
.gitignore

# Python environment and caches
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local dev artefacts (contains secrets and local DBs)
platform/.env
platform/platform.db

# Secrets and env files (never bake these into any image)
.env
.env.*
!.env.example

# OS noise
.DS_Store
*.log

# Docs and dashboards (not needed in either runtime)
docs/
dashboards/
*.md
!README.md

# Synthetic CSV data — dead weight in the runtime image
data/raw/